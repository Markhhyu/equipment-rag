# =============================================================================
# Equipment RAG Agent 环境变量模板
# =============================================================================
# 使用方法（Windows PowerShell）：
#   1. Copy-Item .env.example .env
#   2. notepad .env
#   3. 至少填写 OPENAI_API_KEY，并确认模型名称可用。
#   4. docker compose up --build
#
# 重要规则：
# - `.env` 已被 Git 忽略，真实密钥只能写入 `.env`，不要写进源码、README 或提交记录。
# - 布尔值统一填写 true/false；列表通常用英文逗号分隔，不要在末尾加逗号。
# - 使用 Docker Compose 时，容器之间通过服务名连接，例如 mongo、minio、milvus。
# - 不使用 Docker、直接在宿主机运行 Python 时，把上述服务名改为 127.0.0.1。
# - 示例中的本地密码只用于开发；部署到服务器前必须全部更换。

# =============================================================================
# 端口与监听地址
# =============================================================================
# 作用：决定宿主机从哪里访问各个容器。修改左侧宿主机端口不会改变容器内部端口。
# 127.0.0.1：只允许本机访问，适合开发；0.0.0.0：允许局域网/公网网卡访问，必须配防火墙和认证。
BIND_ADDRESS=127.0.0.1
# 导入页面和导入 API 的宿主机端口：http://localhost:8000/import.html
IMPORT_API_PORT=8000
# 聊天页面和查询 API 的宿主机端口：http://localhost:8001/chat.html
QUERY_API_PORT=8001
# 以下端口用于调试中间件；端口冲突时只修改等号右侧即可。
MONGO_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# =============================================================================
# OpenAI 兼容的大模型接口（必填）
# =============================================================================
# 用途：
# - LLM_DEFAULT_MODEL：问题改写、HyDE、设备识别和最终答案生成。
# - VL_MODEL：读取文档图片并生成图片摘要。
#
# OPENAI_BASE_URL 怎么填：
# - OpenAI 官方：https://api.openai.com/v1
# - 阿里云百炼：创建 API Key 后复制同地域的“API Host”，必须选择 OpenAI 兼容地址。
# - 其他服务：复制服务商文档中的 OpenAI-compatible base_url，通常以 /v1 结尾。
# - 不要填写具体接口路径，例如不要追加 /chat/completions。
OPENAI_BASE_URL=https://api.openai.com/v1

# OPENAI_API_KEY 怎么拿：
# - OpenAI：登录 https://platform.openai.com/api-keys，创建 Project API Key；完整密钥通常只显示一次。
# - 阿里云百炼：登录百炼控制台 → API Key → 创建 API Key；同时保存 API Host 和密钥。
# - 其他兼容服务：在对应控制台创建 API Key/Token。
# - ChatGPT Plus/Pro 订阅不等于 API 额度；API 通常需要单独开通计费。
# - 只填写密钥本身，不要加 `Bearer `、引号或多余空格。
OPENAI_API_KEY=

# 模型名称必须是当前 API Key 有权限调用的“模型 ID”，不是网页上展示的中文名称。
# OpenAI 默认示例使用 gpt-4.1-mini；使用百炼时可改成控制台提供的 Qwen 模型 ID。
LLM_DEFAULT_MODEL=gpt-4.1-mini
# 视觉模型必须支持图片输入；若只测试纯文本 Markdown，可暂时与对话模型相同。
VL_MODEL=gpt-4.1-mini
# 生成随机性，范围通常为 0~2；设备知识问答建议使用 0~0.3，降低回答漂移。
LLM_DEFAULT_TEMPERATURE=0.1
# 流式调用时是否额外请求 Token 用量；兼容接口不支持时可设为 false。
LLM_STREAM_USAGE=true

# =============================================================================
# 图片资产化、异步视觉增强与查询阶段视觉推理
# =============================================================================
# 图片处理模式：off 只保存图片；smart 仅增强缺少有效图注的图片；all 增强所有符合条件的图片。
# 本地首次验证建议使用 smart，可保留图片语义，同时避免对已有清晰图注重复调用视觉模型。
IMAGE_PROCESS_MODE=smart
# MongoDB 中保存图片资产、处理状态和视觉说明的集合名称；已有数据后不要随意修改。
IMAGE_ASSET_COLLECTION=document_image_assets

# true：文档导入完成后由后台线程继续生成图片说明，不阻塞文本切片和向量入库。
IMAGE_ENRICHMENT_ASYNC=true
# 单个导入服务进程启动的图片增强线程数；调大可提升吞吐，但会增加模型并发和内存占用。
IMAGE_ENRICHMENT_WORKERS=2
# 没有待处理图片时的轮询间隔，单位秒；过小会增加 MongoDB 空轮询负载。
IMAGE_ENRICHMENT_POLL_SECONDS=3
# Worker 领取图片后的租约时间，单位秒；应大于正常单张处理时间，进程异常后过期任务可重新领取。
IMAGE_ENRICHMENT_LEASE_SECONDS=180

# 单个文档最多进入视觉增强队列的图片数，用于限制大 PDF 的模型费用和处理时长。
IMAGE_CAPTION_MAX_PER_DOCUMENT=30
# 后台生成单张图片说明的模型请求超时，单位秒；网络较慢或图片复杂时可适当增大。
IMAGE_CAPTION_TIMEOUT_SECONDS=45
# 单张图片失败后的最大重试次数；超过后标记 failed，避免异常图片无限调用模型。
IMAGE_CAPTION_MAX_RETRIES=1
# 当前进程内所有图片 Worker 合计每分钟最多发起的视觉请求数，应按模型服务限流调整。
IMAGE_CAPTION_REQUESTS_PER_MINUTE=30

# 小于该字节数的图片通常是图标、Logo 或装饰元素，默认不进入视觉增强。
IMAGE_MIN_BYTES=8192
# 单张图片允许的最大字节数；图片会读入内存并转为 Base64，限制体积可避免异常内存占用。
IMAGE_MAX_BYTES=20971520
# smart 模式下，已有图注或上下文达到该字符数时认为语义足够，不再调用视觉模型。
IMAGE_STRONG_CAPTION_MIN_CHARS=12
# 保存图片前后文的最大字符数；调大可增加语义，也会增加 MongoDB 记录和提示词长度。
IMAGE_CONTEXT_CHARS=240

# 查询阶段是否允许根据图片、界面、按钮位置等问题按需调用视觉模型。
QUERY_IMAGE_VISION_ENABLED=true
# 每次查询最多选择的相关图片数；调大可能提升覆盖，也会增加延迟和图片输入成本。
QUERY_IMAGE_TOP_K=3
# 查询阶段视觉模型请求超时，单位秒；超时后降级使用缓存图片说明，不中断文本回答。
QUERY_IMAGE_VISION_TIMEOUT_SECONDS=45

# =============================================================================
# 聊天图片附件：只属于当前会话，不进入Milvus、文档切片或知识库图片资产集合
# =============================================================================
# 单轮最多上传图片数量；前端和后端都会校验，默认3张与QUERY_IMAGE_TOP_K保持一致。
CHAT_ATTACHMENT_MAX_FILES=3
# 单张图片最大字节数；10485760 = 10 MiB。视觉模型调用时会转为Base64，不建议设得过大。
CHAT_ATTACHMENT_MAX_BYTES=10485760
# 文件扩展名和真实文件签名会同时校验；只改扩展名不能绕过类型限制。
CHAT_ATTACHMENT_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
CHAT_ATTACHMENT_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# =============================================================================
# Embedding 向量模型：把文本转换为 Milvus 可检索的向量
# =============================================================================
# BGE_M3 是模型仓库 ID。BGE_M3_PATH 为空时首次启动会联网下载到 model-cache 卷。
BGE_M3=BAAI/bge-m3
# 已在运行环境中准备本地模型时填写绝对路径；Docker 默认不会自动挂载任意宿主机目录。
# 初次使用建议保持为空，让容器自动下载并缓存。
BGE_M3_PATH=
# CPU：兼容性最好但速度较慢；NVIDIA GPU 常用 cuda:0，且容器必须配置 GPU 运行时。
BGE_DEVICE=cpu
# FP16 主要用于 CUDA；CPU 模式必须保持 false。
BGE_FP16=false

# =============================================================================
# Reranker 重排序模型：对 Milvus 召回结果再次排序，提高最终上下文相关性
# =============================================================================
# provider 支持 bge 或 qwen；首次使用建议保持 bge。
RERANKER_PROVIDER=bge
# 可以填写模型仓库 ID，也可以填写运行环境中已下载模型的绝对路径。
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
# 只有 CUDA 设备建议设为 true；CPU 使用 FP16 可能报错或更慢。
RERANKER_USE_FP16=false
# 每批处理的候选文本数；显存/内存不足时减小，吞吐不足且资源充足时增大。
RERANKER_BATCH_SIZE=8
# 单条候选文本最大 Token 长度；增大可保留更多内容，但会增加显存和耗时。
RERANKER_MAX_LENGTH=512
# 当前动态 TopK 使用原始分数判断“分数断崖”，不要随意改为 true。
RERANKER_NORMALIZE_SCORE=false

# =============================================================================
# RAG效果调优参数：修改前先建立黄金评测集，修改后必须运行回归评测
# =============================================================================
# 下面这些参数直接影响“能否召回正确内容”和“回答上下文是否有噪声”。
# 不建议一次修改多个参数，否则指标变化后很难判断究竟是哪一项产生作用。
# 每次实验建议：只改一个参数 → 导入相同文档 → 运行相同评测集 → 比较Langfuse/Grafana报告。

# 单个文本切片允许的最大字符数。过大时一个切片包含太多主题，检索容易命中但回答噪声增加；
# 过小时上下文被切得太碎，完整操作步骤、表格说明可能被拆散。设备手册可从1500~2500开始实验。
RAG_CHUNK_MAX_CHARS=2000

# 同一标题下的短切片会尽量合并到这个长度。提高它可减少碎片，但也可能把不同小节合并。
# 必须小于等于RAG_CHUNK_MAX_CHARS。建议先保持最大长度的1/4左右。
RAG_CHUNK_MIN_CHARS=500

# Dense和Sparse每一路先从Milvus召回多少候选。提高通常有利于Recall，但会增加检索和Rerank耗时。
# 如果黄金评测中的retrieval_recall偏低，可从10逐步试到20或30，不要直接设成几百。
RAG_RETRIEVAL_CANDIDATE_LIMIT=10

# Milvus混合检索最终返回给RRF的数量。该值不能大于候选数量。
# 值过小可能漏掉正确Chunk，值过大会增加后续Reranker成本。
RAG_RETRIEVAL_RESULT_LIMIT=5

# Dense权重偏向语义相似，适合自然语言问法、同义表达和较长问题。
RAG_DENSE_WEIGHT=0.8
# Sparse权重偏向关键词精确匹配，适合设备型号、错误码、零件编号和专业术语。
# 两个权重不强制相加等于1，但为了便于理解和比较，建议总和保持为1。
RAG_SPARSE_WEIGHT=0.2

# RRF常数K控制排名差异的影响。K越小越强调每一路的头部结果，K越大排名差异越平滑。
# 60是经典默认值；没有评测证据时不要修改。
RAG_RRF_K=60
# RRF融合后最多交给Reranker多少条本地候选。
RAG_RRF_MAX_RESULTS=10
# 普通混合检索和HyDE检索在RRF中的相对权重。
# 如果观察到HyDE经常偏离原问题，可降低HYDE_WEIGHT，例如0.5；不要凭单个案例调整。
RAG_RRF_EMBEDDING_WEIGHT=1.0
RAG_RRF_HYDE_WEIGHT=1.0

# Reranker动态TopK的上下限。MAX越大，答案可使用的证据越多，但Prompt更长、噪声和Token成本更高。
RAG_RERANK_MAX_TOPK=10
RAG_RERANK_MIN_TOPK=1

# 相邻Rerank分数出现“断崖”时提前截断。
# GAP_RATIO是相对差异，GAP_ABS是绝对差异；满足任意一个条件就会截断。
# 不同Reranker模型的原始分数范围不同，切换模型后必须重新观察分数分布再调整。
RAG_RERANK_GAP_RATIO=0.25
RAG_RERANK_GAP_ABS=0.5

# 商品名称语义匹配的自动确认最低分，范围0~1，默认0.90。
# 注意：LJ2268这类明确型号优先做型号token匹配，不受该阈值限制；这里主要控制“激光打印机”等中文名称。
# 调低会减少澄清次数，但更容易把相近设备认错；调高会更保守，但用户可能需要更频繁地补充型号。
RAG_ITEM_NAME_AUTO_CONFIRM_SCORE=0.90

# 自动确认时Top1必须领先Top2的最小差值，范围0~1，默认0.08。
# 例如第一名0.93、第二名0.90时差值只有0.03，系统会要求澄清，而不会盲选第一名。
# 如果知识库里同系列设备很多，建议保持或适当提高；修改后应重点观察型号确认率和澄清率。
RAG_ITEM_NAME_AUTO_CONFIRM_MARGIN=0.08

# 商品名称候选最低分，范围0~1，默认0.78，程序会保证它不高于自动确认最低分。
# 低于该值的语义结果不会展示给用户，避免把无关设备作为候选；设置太高则可能直接提示“未找到产品”。
# 推荐先通过Langfuse查看真实分数分布，再以0.02为步长小幅调整，不要一次跨越很大范围。
RAG_ITEM_NAME_CANDIDATE_SCORE=0.78

# =============================================================================
# 应用环境、API 认证、跨域和上传限制
# =============================================================================
# development：允许关闭认证，方便本地学习。
# production/prod：强制 AUTH_MODE=api_key 且禁止公开 MinIO，否则服务拒绝启动。
APP_ENVIRONMENT=development

# disabled：请求无需 X-API-Key，仅限本地开发。
# api_key：所有受保护接口必须在请求头携带 `X-API-Key: 你的应用密钥`。
AUTH_MODE=disabled

# 这是“本项目自己的访问密钥”，不是 OpenAI Key，需要自己生成。
# Windows PowerShell 生成 32 字节随机密钥：
#   $bytes = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
#
# 字段说明：
# - id：密钥名称，只用于日志和管理，不是登录账号。
# - key：上面生成的随机字符串，至少 24 个字符。
# - tenant_id：租户 ID；不同租户的会话、文件、检索数据相互隔离，只能用字母、数字、_、-。
# - roles：admin 拥有全部权限；query 允许问答；import 允许上传和导入。
# 单租户示例：
# AUTH_API_KEYS_JSON=[{"id":"local-admin","key":"替换为随机密钥","tenant_id":"local","roles":["admin"]}]
# 多租户示例：
# AUTH_API_KEYS_JSON=[{"id":"factory-a-query","key":"密钥A","tenant_id":"factory-a","roles":["query"]},{"id":"factory-b-import","key":"密钥B","tenant_id":"factory-b","roles":["import"]}]
AUTH_API_KEYS_JSON=

# 浏览器允许跨域访问 API 的前端地址，多个地址用英文逗号分隔，不能填 *。
# 地址必须包含协议和端口，不要带路径；部署前端后改成真实域名，例如 https://rag.example.com。
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001
# 单个上传文件最大字节数；104857600 = 100 MiB。反向代理的上传限制也必须同步调整。
MAX_UPLOAD_BYTES=104857600
# 允许上传的扩展名，多个值用英文逗号分隔；当前流程正式支持 PDF 和 Markdown。
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.md

# =============================================================================
# Milvus：保存 Dense/Sparse 向量和设备实体，负责语义检索
# =============================================================================
# Docker Compose 内使用服务名 milvus；宿主机直接运行时改为 http://127.0.0.1:19530。
# 使用外部 Milvus 时填写其 URI；若启用鉴权，还需要在客户端代码中扩展用户名/Token 配置。
MILVUS_URL=http://milvus:19530
# 三个集合名称相当于数据库表名；已有数据后修改名称会让应用看不到旧集合。
CHUNKS_COLLECTION=equipment_chunks
ENTITY_NAME_COLLECTION=equipment_entities
ITEM_NAME_COLLECTION=equipment_item_names

# =============================================================================
# MongoDB：保存会话历史、反馈、Agent 运行状态和 LangGraph 检查点
# =============================================================================
# 下面的账号和密码由你自己定义，Compose 首次创建 MongoDB 数据卷时用于初始化管理员。
# 修改已存在数据卷对应的环境变量不会自动修改数据库里的旧密码。
MONGO_INITDB_ROOT_USERNAME=equipment
MONGO_INITDB_ROOT_PASSWORD=equipment-local
# URI 格式：mongodb://用户名:密码@主机:端口/数据库?authSource=admin
# Docker 内主机名是 mongo；宿主机直连改为 127.0.0.1。
# 用户名或密码含 @、:、/、?、# 等字符时必须先进行 URL 编码。
MONGO_URL=mongodb://equipment:equipment-local@mongo:27017/equipment_rag?authSource=admin
MONGO_DB_NAME=equipment_rag

# =============================================================================
# Agent 持久化运行：记录任务状态、重试次数和 Worker 租约
# =============================================================================
# mongodb：适合正式运行，服务重启后状态仍存在；memory：只适合测试，进程退出即丢失。
RUN_STORE_BACKEND=mongodb
RUN_STORE_COLLECTION=agent_runs
# 单个任务最多领取/重试次数，避免永久失败任务无限循环。
RUN_MAX_ATTEMPTS=3
# Worker 领取任务后的租约秒数；Worker 崩溃且租约过期后，其他 Worker 才能安全接管。
# 应大于一次正常节点处理时间；长耗时任务需要心跳续租或适当增大。
RUN_LEASE_SECONDS=900

# =============================================================================
# LangGraph 检查点：保存图执行进度，失败重试时从最近成功节点继续
# =============================================================================
# mongodb：可跨进程恢复；memory：只在当前进程有效。
LANGGRAPH_CHECKPOINT_BACKEND=mongodb
LANGGRAPH_CHECKPOINT_DB=equipment_rag_checkpoints
# 检查点保留秒数；604800 = 7 天。设得越大，占用的 MongoDB 空间越多。
LANGGRAPH_CHECKPOINT_TTL_SECONDS=604800

# =============================================================================
# MinIO：保存上传的原始文件、PDF 和 Markdown 中提取的图片
# =============================================================================
# MINIO_ENDPOINT 是服务端内部连接地址，不带 http:// 或 https://。
# Docker 内使用 minio:9000；宿主机直接运行时使用 127.0.0.1:9000。
MINIO_ENDPOINT=minio:9000
# 返回给浏览器的地址。浏览器无法解析 Docker 服务名，所以默认使用 localhost:9000。
# 部署到服务器后填写浏览器真正能访问的域名或 IP，例如 files.example.com。
MINIO_PUBLIC_ENDPOINT=localhost:9000
# 这两个值是你自己定义的 MinIO 管理账号和密码，不需要去第三方平台申请。
# Compose 会同时把它们作为 MINIO_ROOT_USER/MINIO_ROOT_PASSWORD 启动 MinIO。
# 生产环境必须换成长随机值，并确保反向代理使用 HTTPS。
MINIO_ACCESS_KEY=equipment
MINIO_SECRET_KEY=equipment-local
MINIO_BUCKET_NAME=equipment-rag
# 桶内目录前缀，不是宿主机文件夹；修改后新文件会写到新前缀。
MINIO_IMG_DIR=images
MINIO_PDF_DIR=pdf_files
# false 使用 HTTP；true 使用 HTTPS。它必须与 MINIO_ENDPOINT 实际协议一致。
MINIO_SECURE=false
# MinIO 默认区域。服务端和签名客户端必须一致；明确配置后，查询容器生成浏览器签名URL时
# 不需要访问 localhost 等宿主机公开地址。除非现有 MinIO 使用了自定义区域，否则不要修改。
MINIO_REGION=us-east-1
# false：对象保持私有，通过临时签名 URL 访问；生产环境必须保持 false。
MINIO_PUBLIC_READ=false
# 私有对象临时访问链接有效期；3600 = 1 小时。
MINIO_PRESIGNED_URL_TTL_SECONDS=3600

# =============================================================================
# MinerU：把 PDF 解析为 Markdown、图片和结构化 JSON
# =============================================================================
# Markdown 导入不需要 MinerU；只有上传 PDF 时才需要启动独立 MinerU 服务。
# Docker 容器访问宿主机使用 host.docker.internal；宿主机直接运行应用时改为 127.0.0.1。
MINERU_API_BASE_URL=http://host.docker.internal:8002
# 自部署 mineru-api 默认无 Token，保持为空。
# 若你在 MinerU 前面配置了 API 网关/反向代理鉴权，则填写网关管理员发放的 Bearer Token。
MINERU_API_TOKEN=
# pipeline：CPU 可运行，最适合首次启动；hybrid-engine/vlm：需要相应 GPU 和模型环境。
MINERU_BACKEND=pipeline
# high 更重视图片和图表质量；medium 更快。具体能力取决于 MinerU 后端。
MINERU_EFFORT=high
# auto 自动判断文本提取或 OCR；扫描件识别异常时再按 MinerU 文档调整。
MINERU_PARSE_METHOD=auto
# OCR 语言。项目会校验该值；中英文混合文档建议 ch_server，不要填写 auto。
MINERU_LANGUAGE=ch_server
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
# pipeline 默认 false；使用支持视觉分析的 hybrid/vlm 后端时再改为 true。
MINERU_IMAGE_ANALYSIS=false
# 保留结构化中间产物，便于后续更精细的切片和问题排查。
MINERU_RETURN_MIDDLE_JSON=true
MINERU_RETURN_CONTENT_LIST=true
# 轮询异步任务状态的间隔秒数，过小会增加 MinerU 压力。
MINERU_POLL_INTERVAL_SECONDS=3
# 单个解析任务允许的总时间；3600 = 1 小时，大型 PDF 可适当增大。
MINERU_TASK_TIMEOUT_SECONDS=3600
# 创建任务等普通 HTTP 请求超时。
MINERU_REQUEST_TIMEOUT_SECONDS=60
# 下载 MinerU 解析结果压缩包的超时。
MINERU_DOWNLOAD_TIMEOUT_SECONDS=600
# 生产 HTTPS 服务保持 true；仅在本地自签名证书排障时临时设为 false。
MINERU_VERIFY_SSL=true

# =============================================================================
# 阿里云百炼 WebSearch MCP（可选）：让 Agent 查询实时网页
# =============================================================================
# 获取方式：
# 1. 登录百炼控制台，在 MCP 广场开通“联网搜索”。
# 2. 当前官方服务使用 Streamable HTTP，地址如下；旧版 /sse 地址不再推荐。
# 3. 在百炼“API Key”页面创建通用 API Key，不要使用 Coding/Token Plan 专属 Key。
# 官方说明：https://help.aliyun.com/zh/model-studio/web-search-mcp
# 填写示例：https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# 不使用联网搜索时保持为空，避免每次问答尝试连接外部 MCP。
MCP_DASHSCOPE_BASE_URL=
# 建议单独填写百炼通用 API Key；为空时为了兼容旧配置会回退到 OPENAI_API_KEY。
# 只填 sk-.../sk-ws-... 本身，代码会自动添加 `Bearer `。
MCP_DASHSCOPE_API_KEY=
# streamable_http：当前官方协议；sse：仅兼容仍提供旧版 /sse 端点的私有部署。
MCP_DASHSCOPE_TRANSPORT=streamable_http
# 百炼联网搜索工具的固定名称；接入其他 MCP 服务时按其工具列表修改。
MCP_DASHSCOPE_TOOL_NAME=bailian_web_search

# =============================================================================
# Langfuse（可选）：记录 Agent Trace、Token、评分和用户反馈
# =============================================================================
# false 时完全关闭，不需要填写后续三项。
LANGFUSE_TRACING_ENABLED=false
# 默认不让Langfuse SDK自动上传Base64图片。Trace仍会记录图片数量、状态和定位摘要，
# 可避免应用容器访问仅供浏览器使用的宿主机MinIO公开地址时出现Media upload error。
# 仅当Langfuse媒体存储地址可从应用容器直接访问，并确实需要在Trace中查看原图时才改为true。
LANGFUSE_MEDIA_UPLOAD_ENABLED=false
# 自部署并由主项目容器访问：http://host.docker.internal:3000
# Langfuse Cloud：填写账号所在区域对应的 Host，以控制台/官方文档为准。
LANGFUSE_HOST=http://host.docker.internal:3000
# 获取方式：登录 Langfuse → 进入项目 → Project Settings → API Keys → Create new API keys。
# Public Key 常以 pk-lf- 开头，可用于标识项目；Secret Key 常以 sk-lf- 开头，必须保密。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# =============================================================================
# Prometheus + Grafana：运行稳定性和趋势仪表盘（推荐与Langfuse同时使用）
# =============================================================================
# true时两个FastAPI服务会开放/metrics。指标只包含数字、服务名、节点名和状态，
# 不包含问题、答案、文件名、文档正文、session_id或trace_id。
PROMETHEUS_METRICS_ENABLED=true

# 使用以下命令启动Prometheus和Grafana：
#   docker compose --profile observability up -d
# Prometheus页面：http://localhost:9090
# Grafana页面：http://localhost:3001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Attu 是 Milvus 的可视化管理页面。3001 已分配给 Grafana，所以默认使用 3002。
# 一键启动脚本会把根目录 .env 传给 Attu Compose；手工启动时也应添加 --env-file .env。
ATTU_PORT=3002

# Prometheus本地保存多久的历史指标。开发环境15天通常足够；生产环境按磁盘容量调整。
PROMETHEUS_RETENTION_TIME=15d

# Grafana初始管理员账号。下面密码只适合本机开发，服务器部署前必须改成长随机密码。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=equipment-local

# =============================================================================
# Neo4j（可选/预留）：后续保存和查询设备知识图谱
# =============================================================================
# 当前主流程不依赖 Neo4j，未部署时三项全部保持为空。
# 本地 Neo4j 常用 bolt://127.0.0.1:7687。
# Neo4j Aura：创建实例时下载 credentials 文件，其中包含 URI、用户名和只显示一次的密码。
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# =============================================================================
# 日志：控制台用于实时排障，文件日志保存在项目 logs 目录/容器持久卷
# =============================================================================
LOG_CONSOLE_ENABLE=true
# 常用级别：DEBUG、INFO、WARNING、ERROR。生产环境建议 INFO，排障时临时改 DEBUG。
LOG_CONSOLE_LEVEL=INFO
# Windows 中文日志乱码时保持 utf-8，并使用支持 UTF-8 的终端。
LOG_CONSOLE_ENCODING=utf-8
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
# Loguru 保留策略，例如 7 days、2 weeks、1 month。
LOG_FILE_RETENTION=7 days
# true 使用后台队列写日志，适合并发服务；本地排障保持 false 更直观。
LOG_ENQUEUE=false
