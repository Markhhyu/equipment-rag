# Copy this file to .env only when you need to override the safe local defaults.

# OpenAI-compatible LLM (required for importing metadata and answering questions)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=gpt-4.1-mini
VL_MODEL=gpt-4.1-mini
LLM_DEFAULT_TEMPERATURE=0.1
LLM_STREAM_USAGE=true

# Embedding and reranking (CPU defaults work out of the box)
BGE_M3=BAAI/bge-m3
BGE_M3_PATH=
BGE_DEVICE=cpu
BGE_FP16=false
RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_USE_FP16=false
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_NORMALIZE_SCORE=false

# Core middleware
BIND_ADDRESS=127.0.0.1
MILVUS_URL=http://milvus:19530
CHUNKS_COLLECTION=equipment_chunks
ENTITY_NAME_COLLECTION=equipment_entities
ITEM_NAME_COLLECTION=equipment_item_names
MONGO_INITDB_ROOT_USERNAME=equipment
MONGO_INITDB_ROOT_PASSWORD=equipment-local
MONGO_URL=mongodb://equipment:equipment-local@mongo:27017/equipment_rag?authSource=admin
MONGO_DB_NAME=equipment_rag
RUN_STORE_BACKEND=mongodb
RUN_STORE_COLLECTION=agent_runs
RUN_MAX_ATTEMPTS=3
RUN_LEASE_SECONDS=900
LANGGRAPH_CHECKPOINT_BACKEND=mongodb
LANGGRAPH_CHECKPOINT_DB=equipment_rag_checkpoints
LANGGRAPH_CHECKPOINT_TTL_SECONDS=604800
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=equipment
MINIO_SECRET_KEY=equipment-local
MINIO_BUCKET_NAME=equipment-rag
MINIO_IMG_DIR=images
MINIO_PDF_DIR=pdf_files
MINIO_SECURE=false

# MinerU runs separately; Markdown import works without it.
MINERU_API_BASE_URL=http://host.docker.internal:8002
MINERU_API_TOKEN=
MINERU_BACKEND=pipeline
MINERU_EFFORT=high
MINERU_PARSE_METHOD=auto
MINERU_LANGUAGE=ch_server
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_IMAGE_ANALYSIS=false
MINERU_RETURN_MIDDLE_JSON=true
MINERU_RETURN_CONTENT_LIST=true
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_DOWNLOAD_TIMEOUT_SECONDS=600
MINERU_VERIFY_SSL=true

# Optional integrations
MCP_DASHSCOPE_BASE_URL=
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Logging
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_CONSOLE_ENCODING=utf-8
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
LOG_ENQUEUE=false
