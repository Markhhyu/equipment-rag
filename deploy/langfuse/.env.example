# =============================================================================
# Langfuse 自部署配置模板
# =============================================================================
# 使用方法：
#   1. Copy-Item .env.example .env
#   2. 为每个“必须修改”项生成不同的随机值。
#   3. docker compose --env-file .env config --quiet
#   4. docker compose up -d
#
# PowerShell 生成 32 字节十六进制随机值：
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
#
# 不要把此目录下的 .env 提交到 Git。生产环境还应使用外部密钥管理服务。

# 浏览器访问 Langfuse 的完整地址。反向代理部署时改为真实 HTTPS 域名。
NEXTAUTH_URL=http://localhost:3000
# NextAuth 会话签名密钥，必须修改为独立随机值。
NEXTAUTH_SECRET=replace_with_random_hex
# Langfuse 对部分数据做哈希/派生时使用的盐值，必须修改且部署后保持稳定。
SALT=replace_with_random_hex
# 数据加密主密钥，必须是 64 个十六进制字符；丢失后已加密数据可能无法恢复。
ENCRYPTION_KEY=replace_with_exactly_64_hex_characters

# PostgreSQL 保存 Langfuse 业务元数据。
# 建议密码只使用随机十六进制字符，避免 DATABASE_URL 额外做 URL 编码。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_random_hex
POSTGRES_DB=postgres
POSTGRES_VERSION=17
# 用户名、密码和数据库名必须与上面三项一致；主机名 postgres 是 Compose 服务名。
DATABASE_URL=postgresql://postgres:replace_with_random_hex@postgres:5432/postgres

# ClickHouse 保存高吞吐 Trace/Observation 分析数据。
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=replace_with_random_hex
# 以下地址是 Compose 内部地址，除非改了服务名或使用外部 ClickHouse，否则不要修改。
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
# 单机 Compose 保持 false；只有按 Langfuse 官方集群方案部署时才启用。
CLICKHOUSE_CLUSTER_ENABLED=false

# Redis 保存任务队列和缓存；命令行与应用连接必须使用同一个密码。
REDIS_AUTH=replace_with_random_hex
REDIS_HOST=redis
REDIS_PORT=6379
# 本地 Compose 内网默认不启用 Redis TLS；使用外部 TLS Redis 时填写三个证书路径。
REDIS_TLS_ENABLED=false
REDIS_TLS_CA=/certs/ca.crt
REDIS_TLS_CERT=/certs/redis.crt
REDIS_TLS_KEY=/certs/redis.key
# 跳过版本检查可能掩盖兼容问题，只有确认外部 Redis 兼容时才改为 true。
LANGFUSE_BULLMQ_SKIP_REDIS_VERSION_CHECK=false

# Langfuse 内部 MinIO 保存事件、媒体和批量导出文件。
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace_with_random_hex
# 以下三项必须与 MINIO_ROOT_USER/MINIO_ROOT_PASSWORD 匹配。
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace_with_random_hex
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=replace_with_random_hex
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=replace_with_random_hex
# 事件上传走容器内部 MinIO；bucket 和 prefix 相当于对象存储目录。
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
# 媒体外部地址使用宿主机映射的 9090 端口，浏览器才能访问。
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9090
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
# 批量导出默认关闭；启用后内部 Endpoint 用 minio，外部下载地址用 localhost。
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_REGION=auto
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9090
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true

# 本模板使用 S3 兼容的 MinIO，不启用 Azure Blob 或 OCI 原生对象存储。
LANGFUSE_USE_AZURE_BLOB=false
LANGFUSE_USE_OCI_NATIVE_OBJECT_STORAGE=false
LANGFUSE_OCI_AUTH_TYPE=workload_identity

# 是否允许 Langfuse 发送匿名遥测；企业内网可按合规要求关闭。
TELEMETRY_ENABLED=false
# 实验功能可能发生不兼容变化，正式环境保持 false。
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
# 下面两个摄取参数为空时使用 Langfuse 默认值，未经压测不要手工调整。
LANGFUSE_INGESTION_QUEUE_DELAY_MS=
LANGFUSE_INGESTION_CLICKHOUSE_WRITE_INTERVAL_MS=

# 可选：首次启动时自动创建组织、项目和管理员。
# 初学者建议全部留空，在网页中手动注册和创建项目。
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# 可选：邮件邀请和通知。未配置 SMTP 时保持为空。
EMAIL_FROM_ADDRESS=
SMTP_CONNECTION_URL=
